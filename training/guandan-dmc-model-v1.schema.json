{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "guandan-dmc-model-v1 manifest",
  "type": "object",
  "required": ["schema", "status", "onnx", "features", "actions", "training", "evaluation", "license"],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "seedManifest": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
    }
  },
  "properties": {
    "schema": { "const": "guandan-dmc-model-v1" },
    "status": { "enum": ["experimental", "validated", "promoted"] },
    "onnx": {
      "type": "object", "required": ["file", "sha256"],
      "properties": { "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "features": {
      "type": "object", "required": ["schema", "sha256"],
      "properties": { "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "actions": {
      "type": "object", "required": ["schema", "sha256"],
      "properties": { "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "training": {
      "type": "object", "required": ["datasetSha256", "seedManifest", "conformanceReceiptSha256"],
      "properties": {
        "datasetSha256": { "$ref": "#/$defs/sha256" },
        "seedManifest": { "$ref": "#/$defs/seedManifest" },
        "conformanceReceiptSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "evaluation": {
      "type": "object", "required": ["receiptSha256", "candidate", "comparison"],
      "properties": { "receiptSha256": { "$ref": "#/$defs/sha256" } }
    },
    "license": { "type": "object", "required": ["sources", "notice"] }
  }
}
